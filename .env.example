# 复制为 .env 后填写。任何支持 function calling 的 OpenAI 兼容接口都可以。
# DeepSeek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-chat
# 硅基流动免费模型（需实名认证；README 里的三方对比就是用它跑的）
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=Qwen/Qwen3-8B
# 通义千问
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 国内访问 HuggingFace 慢时打开镜像；或者直接运行 python download_model.py 从魔搭下载
# HF_ENDPOINT=https://hf-mirror.com

# 知识库目录，默认 data/knowledge-base
# KB_DIR=data/knowledge-base

# 检索参数（改了 CHUNK_SIZE / CHUNK_OVERLAP 要重新运行 ingest.py）
# CHUNK_SIZE=500
# CHUNK_OVERLAP=80
# TOP_K=5

# API 服务（api.py）：每个客户端的请求频率、同时进行的回答数上限、访问密钥（逗号分隔，留空则不校验并按 IP 限流）
# RATE_LIMIT=10/minute
# MAX_CONCURRENT=4
# API_KEYS=

# 可选：LangSmith 追踪
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2-xxx
